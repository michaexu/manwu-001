.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 30rpx;
  color: #475569;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #94A3B8;
  margin-bottom: 32rpx;
}

.empty-btn {
  padding: 14rpx 40rpx;
  background: #DC2626;
  border-radius: 40rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}
