.activity-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,.05);
  transition: transform .15s;
}

.activity-card:active {
  transform: scale(.98);
}

.card-image {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-emoji {
  font-size: 72rpx;
}

.card-content {
  flex: 1;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.card-header {
  margin-bottom: 8rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E293B;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quota-tags {
  display: flex;
  gap: 8rpx;
  margin-top: 6rpx;
}

.tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.vip-tag {
  background: #FEF3C7;
  color: #B45309;
}

.regular-tag {
  background: #F1F5F9;
  color: #64748B;
}

.card-info {
  margin: 8rpx 0;
}

.gift-name {
  font-size: 26rpx;
  color: #475569;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.merchant-name {
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 4rpx;
  display: block;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.points-badge {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.points-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #DC2626;
}

.points-label {
  font-size: 22rpx;
  color: #94A3B8;
}

.card-action {
  font-size: 24rpx;
  color: #DC2626;
  font-weight: 500;
}
