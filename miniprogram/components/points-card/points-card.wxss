.points-card {
  background: linear-gradient(135deg, #DC2626, #EF4444);
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  color: #fff;
  box-shadow: 0 8rpx 32rpx rgba(220,38,38,.25);
}

.points-main {
  text-align: center;
  margin-bottom: 24rpx;
}

.points-label {
  font-size: 26rpx;
  opacity: .85;
  display: block;
  margin-bottom: 4rpx;
}

.points-value {
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -2rpx;
}

/* VIP配额 */
.vip-quota {
  background: rgba(255,255,255,.15);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}

.quota-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.quota-title {
  font-size: 24rpx;
  opacity: .9;
}

.quota-count {
  font-size: 24rpx;
  font-weight: 600;
}

.quota-bar {
  height: 6rpx;
  background: rgba(255,255,255,.2);
  border-radius: 3rpx;
  overflow: hidden;
}

.quota-fill {
  height: 100%;
  background: rgba(255,255,255,.8);
  border-radius: 3rpx;
  transition: width .4s;
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  align-items: center;
  border-top: 1rpx solid rgba(255,255,255,.15);
  padding-top: 20rpx;
}

.action-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.action-item:active {
  opacity: .7;
}

.action-icon {
  font-size: 32rpx;
}

.action-text {
  font-size: 26rpx;
  font-weight: 500;
}

.action-divider {
  width: 1rpx;
  height: 36rpx;
  background: rgba(255,255,255,.2);
}
