/* 商家后台 — 仪表盘 + 活动列表 */
.merchant-page {
  min-height: 100vh;
  background: #F5F5F5;
  display: flex;
  flex-direction: column;
}

/* ===== 头部 ===== */
.m-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx 16rpx;
  background: #FFFFFF;
}
.shop-info { display: flex; align-items: center; gap: 16rpx; }
.shop-logo {
  width: 72rpx; height: 72rpx;
  display: flex; align-items: center; justify-content: center;
  background: #FFF1F2; border-radius: 16rpx;
}
.shop-logo__emoji { font-size: 36rpx; }
.shop-name { font-size: 34rpx; font-weight: 700; color: #1F2937; }
.header-actions { display: flex; gap: 16rpx; }
.icon-btn {
  width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
  background: #F3F4F6; border-radius: 50%;
  font-size: 36rpx;
}

/* ===== 视图切换 ===== */
.view-tabs {
  display: flex;
  margin: 20rpx 28rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 6rpx;
}
.view-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #6B7280;
  font-weight: 600;
}
.view-tab--active {
  background: linear-gradient(135deg, #DC2626, #EC4899);
  color: #FFFFFF;
}

/* ===== 仪表盘 ===== */
.dashboard-body {
  flex: 1;
  padding: 0 28rpx;
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.quick-action {
  flex: 1;
  height: 120rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.quick-action--create {
  background: linear-gradient(135deg, #DC2626, #EC4899);
}
.quick-action--scan {
  background: #FFFFFF;
  border: 2rpx solid #F3F4F6;
}
.quick-action-icon {
  font-size: 40rpx;
  font-weight: 700;
}
.quick-action--create .quick-action-icon { color: #FFFFFF; }
.quick-action--create .quick-action-label { color: #FFFFFF; font-size: 26rpx; font-weight: 600; }
.quick-action--scan .quick-action-icon { font-size: 36rpx; }
.quick-action--scan .quick-action-label { font-size: 26rpx; color: #1F2937; font-weight: 600; }

/* 列表视图内的快捷操作 */
.quick-actions--list {
  margin-bottom: 20rpx;
}

/* 概览卡片 */
.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.stat-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
}
.stat-num {
  font-size: 52rpx;
  font-weight: 800;
  color: #DC2626;
  display: block;
  line-height: 1;
}
.stat-num-sm {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  display: block;
  line-height: 1;
}
.stat-label {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
  display: block;
}
.stat-label-sm {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
  display: block;
}
.stat-sub {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}
.stat-sub-item {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.stat-sub--active { background: #DCFCE7; color: #16A34A; }
.stat-sub--pause { background: #FEF3C7; color: #D97706; }
.stat-sub--end { background: #F3F4F6; color: #9CA3AF; }
.stat-sub--ok { background: #DCFCE7; color: #16A34A; }
.stat-sub--warn { background: #FEF3C7; color: #F59E0B; }

.stat-card--row {
  display: flex;
  align-items: center;
  padding: 28rpx 16rpx;
}
.stat-half {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: #F3F4F6;
}

/* 月度趋势柱状图 */
.section {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 20rpx;
  display: block;
}
.bar-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 280rpx;
  padding-top: 20rpx;
}
.bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  max-width: 80rpx;
}
.bar-stack {
  flex: 1;
  width: 40rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  background: #F9FAFB;
  border-radius: 8rpx 8rpx 0 0;
  overflow: hidden;
}
.bar-fill {
  width: 100%;
  background: linear-gradient(180deg, #DC2626, #FCA5A5);
  border-radius: 8rpx 8rpx 0 0;
  min-height: 4rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  position: relative;
}
.bar-val {
  font-size: 18rpx;
  color: #FFF;
  font-weight: 700;
  position: absolute;
  top: -26rpx;
}
.bar-label {
  font-size: 20rpx;
  color: #9CA3AF;
  white-space: nowrap;
  text-align: center;
}

/* 热门活动排行 */
.rank-list {
  display: flex;
  flex-direction: column;
}
.rank-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F9FAFB;
}
.rank-item:last-child { border-bottom: none; }
.rank-badge {
  width: 44rpx; height: 44rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.rank-badge--hot { background: #FEF2F2; color: #DC2626; }
.rank-badge--normal { background: #F3F4F6; color: #9CA3AF; }
.rank-info { flex: 1; min-width: 0; }
.rank-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2937;
  display: block;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.rank-meta { margin-top: 4rpx; display: flex; }
.rank-stats {
  display: flex; flex-direction: column; align-items: center;
  gap: 2rpx; flex-shrink: 0; min-width: 72rpx;
}
.rank-num { font-size: 28rpx; font-weight: 700; color: #1F2937; }
.rank-sublabel { font-size: 20rpx; color: #D1D5DB; }

/* ===== 活动列表 (复用原样式) ===== */
.m-list { flex: 1; }

.act-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.act-main {
  display: flex; align-items: center; gap: 20rpx;
  padding: 24rpx;
}
.act-img {
  width: 120rpx; height: 120rpx; border-radius: 16rpx; flex-shrink: 0;
}
.act-img--placeholder {
  background: #FFF1F2;
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx;
}
.act-info { flex: 1; min-width: 0; }
.act-title {
  font-size: 30rpx; font-weight: 700; color: #1F2937;
  display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.act-meta { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 10rpx; }
.act-meta-item { font-size: 24rpx; color: #6B7280; }
.act-tag {
  font-size: 22rpx; padding: 2rpx 12rpx; border-radius: 8rpx; font-weight: 600;
}
.act-tag--on { background: #DCFCE7; color: #16A34A; }
.act-tag--off { background: #F3F4F6; color: #9CA3AF; }
.act-arrow { font-size: 32rpx; color: #D1D5DB; flex-shrink: 0; }
.act-actions {
  display: flex; flex-direction: row; align-items: center; justify-content: space-evenly;
  padding: 12rpx 24rpx 16rpx;
  border-bottom: 1rpx solid #F3F4F6;
}
.act-action {
  font-size: 24rpx; color: #6B7280; padding: 10rpx 0;
  text-align: center; flex: 1; flex-shrink: 0; white-space: nowrap;
}
.act-action--danger { color: #EF4444; }

/* 参与者面板 */
.participants-panel { padding: 0 24rpx 16rpx; }
.loading-sm, .empty-sm {
  text-align: center; padding: 24rpx; font-size: 26rpx; color: #9CA3AF;
}
.participant-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 16rpx 0; border-top: 1rpx solid #F9FAFB;
}
.p-avatar {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #DC2626; color: #FFF;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 700; flex-shrink: 0;
}
.p-info { flex: 1; min-width: 0; }
.p-name { font-size: 26rpx; font-weight: 600; color: #1F2937; display: block; }
.p-phone { font-size: 22rpx; color: #9CA3AF; }
.p-meta { display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx; }
.p-type { font-size: 22rpx; color: #6B7280; }
.p-time { font-size: 20rpx; color: #D1D5DB; }
.p-status { font-size: 22rpx; color: #F59E0B; padding: 4rpx 10rpx; border-radius: 6rpx; background: #FEF3C7; }
.p-status--ok { color: #16A34A; background: #DCFCE7; }

/* 通用 */
.loading-box, .loading-state { text-align: center; padding: 80rpx; color: #9CA3AF; font-size: 28rpx; }
.empty-state {
  display: flex; flex-direction: column; align-items: center;
  padding: 160rpx 0;
}
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #9CA3AF; }
.load-more { text-align: center; padding: 32rpx; font-size: 24rpx; color: #D1D5DB; }

/* ===== 账户管理 ===== */
.acct-card {
  background: linear-gradient(135deg, #DC2626, #EC4899);
  border-radius: 16rpx;
  padding: 40rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.acct-avatar {
  width: 88rpx; height: 88rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx;
}
.acct-name { font-size: 36rpx; font-weight: 700; color: #FFFFFF; }
.acct-role { font-size: 24rpx; color: rgba(255,255,255,0.8); }

.acct-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}
.acct-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F9FAFB;
}
.acct-row:last-child { border-bottom: none; }
.acct-row--link { cursor: pointer; }
.acct-row-label { font-size: 28rpx; color: #1F2937; }
.acct-row-value { font-size: 26rpx; color: #6B7280; }
.acct-row-arrow { font-size: 32rpx; color: #D1D5DB; }
.acct-row--danger .acct-row-label { color: #EF4444; }
.acct-badge {
  font-size: 22rpx; color: #DC2626; background: #FFF1F2;
  padding: 4rpx 16rpx; border-radius: 8rpx; font-weight: 600;
}
