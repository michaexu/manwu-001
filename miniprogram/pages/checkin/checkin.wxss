/**
 * 签到页样式 - 设计参照 Ardot 8:33
 */
.checkin-page {
  min-height: 100vh;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
}

.checkin-content {
  flex: 1;
  padding: 0 32rpx;
}

/* ===== 头部 ===== */
.checkin-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0 24rpx;
}

.ch-title {
  font-size: var(--font-2xl);
  font-weight: 700;
  color: var(--color-text-primary);
}

.ch-rules {
  font-size: var(--font-xs);
  color: var(--color-primary);
  font-weight: 500;
}

/* ===== 今日奖励 ===== */
.today-reward {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--color-primary);
  border-radius: var(--radius-lg);
  padding: 32rpx 40rpx;
  margin-bottom: 32rpx;
}

.reward-icon {
  font-size: 72rpx;
}

.reward-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

.reward-title {
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.8);
}

.reward-value {
  font-size: var(--font-3xl);
  font-weight: 700;
  color: #FFFFFF;
}

/* ===== 签到按钮 ===== */
.checkin-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 104rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: var(--font-lg);
  font-weight: 700;
  border-radius: var(--radius-full);
  margin-bottom: 32rpx;
}

.checkin-btn--done {
  background: var(--color-text-muted);
  color: #FFFFFF;
}

/* ===== 连续签到 ===== */
.streak-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: 28rpx 32rpx;
  margin-bottom: 32rpx;
}

.streak-icon {
  font-size: 48rpx;
}

.streak-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.streak-title {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.streak-value {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-text-primary);
}

.streak-tip {
  margin-left: auto;
  font-size: var(--font-xs);
  color: var(--color-warning);
}

/* ===== 月历 ===== */
.calendar-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: 32rpx;
}

/* 月份导航 */
.month-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 24rpx;
}

.month-nav__arrow {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  border-radius: var(--radius-full);
  background: var(--color-bg);
}

.month-nav__label {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-primary);
  min-width: 160rpx;
  text-align: center;
}

/* 星期表头 */
.weekday-header {
  display: flex;
  margin-bottom: 16rpx;
}

.weekday-cell {
  flex: 1;
  text-align: center;
  font-size: var(--font-xs);
  color: var(--color-text-muted);
  padding: 8rpx 0;
}

/* 日期行 */
.week-row {
  display: flex;
  margin-bottom: 12rpx;
}

.week-row:last-child {
  margin-bottom: 0;
}

.day-cell {
  flex: 1;
  aspect-ratio: 1;
  max-width: calc(100% / 7);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  color: var(--color-text-primary);
  border-radius: var(--radius-sm);
}

.day-cell--empty {
  color: transparent;
}

.day-cell--checked {
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-weight: 600;
}

.day-cell--today:not(.day-cell--checked) {
  background: var(--color-bg);
  color: var(--color-primary);
  font-weight: 700;
}

.day-cell--today.day-cell--checked {
  background: var(--color-primary);
  color: #FFFFFF;
  font-weight: 700;
}

/* 图例 */
.legend {
  display: flex;
  gap: 32rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-border);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--font-xs);
  color: var(--color-text-muted);
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--radius-full);
}

.legend-dot--checked {
  background: var(--color-primary-light);
}

.legend-dot--today {
  background: var(--color-primary);
}
