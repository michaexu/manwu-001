/* 首页样式 */
.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 120rpx;
}

/* 积分卡片 */
.points-card {
  margin: 24rpx 32rpx;
  background: linear-gradient(135deg, #DC2626, #EC4899);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.points-card__inner {
  padding: 40rpx;
  color: #FFFFFF;
}

.points-card__label {
  font-size: var(--font-sm);
  opacity: 0.85;
}

.points-card__value-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.points-card__value {
  font-size: 80rpx;
  font-weight: 800;
  line-height: 1;
}

.points-card__sub {
  margin-top: 12rpx;
  font-size: var(--font-xs);
  opacity: 0.75;
}

/* VIP 月度免积分额度 */
.vip-quota-bar {
  margin-top: 16rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.vip-quota-bar__icon {
  font-size: 28rpx;
}

.vip-quota-bar__text {
  font-size: var(--font-xs);
  opacity: 0.9;
}

.vip-quota-bar__num {
  font-weight: 700;
  font-size: var(--font-sm);
}

.vip-quota-bar--empty {
  opacity: 0.6;
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  gap: 16rpx;
  margin: 0 32rpx 24rpx;
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 16rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  position: relative;
}

.action-item:active {
  opacity: 0.8;
}

.action-item--disabled {
  opacity: 0.5;
}

.action-item__icon {
  font-size: 44rpx;
}

.action-item__text {
  font-size: var(--font-xs);
  color: var(--color-text-primary);
  font-weight: 500;
}

.action-item__bonus {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  font-size: 20rpx;
  color: var(--color-primary);
  font-weight: 600;
}

/* 活动区域 */
.section {
  margin: 0 32rpx;
}

.section__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section__title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text-primary);
}

.section__more {
  font-size: var(--font-sm);
  color: var(--color-primary);
}

/* 活动卡片 */
.activity-card {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
}

.activity-card:active {
  opacity: 0.85;
}

.activity-card__img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.activity-card__emoji {
  font-size: 56rpx;
}

.activity-card__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  overflow: hidden;
}

.activity-card__title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-card__desc {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.activity-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.activity-card__merchant {
  font-size: var(--font-xs);
  color: var(--color-text-muted);
}

/* 活动名额标签 */
.activity-card__quota {
  display: flex;
  gap: 12rpx;
  margin-top: 4rpx;
}

.quota-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 100rpx;
  font-weight: 500;
}

.quota-tag--vip {
  background: #FEF3C7;
  color: #D97706;
}

.quota-tag--regular {
  background: #F3F4F6;
  color: #6B7280;
}

/* 加载骨架屏 */
.loading-state {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.skeleton-card {
  height: 200rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: var(--radius-md);
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-state__icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-state__text {
  font-size: var(--font-base);
  color: var(--color-text-muted);
}
