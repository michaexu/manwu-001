/* 个人中心样式 */
.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 120rpx;
}

/* 个人信息卡片 */
.profile-header {
  position: relative;
  overflow: hidden;
}

.profile-header__bg {
  height: 200rpx;
  background: linear-gradient(135deg, #DC2626, #EC4899);
  border-radius: 0 0 40rpx 40rpx;
}

.profile-header__content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 40rpx 40rpx;
  margin-top: -60rpx;
  position: relative;
  z-index: 1;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  background: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #FFFFFF;
  box-shadow: var(--shadow-md);
}

.avatar__text {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.profile-name {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text-primary);
  margin-top: 16rpx;
}

.profile-phone {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.phone-btn {
  margin-top: 12rpx;
  font-size: var(--font-xs);
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-radius: var(--radius-full);
  padding: 8rpx 24rpx;
  border: none;
  height: auto;
  line-height: 1.5;
}

.phone-btn::after {
  border: none;
}

.vip-badge {
  margin-top: 12rpx;
  padding: 6rpx 20rpx;
  background: linear-gradient(135deg, #D97706, #F59E0B);
  border-radius: var(--radius-full);
  font-size: var(--font-xs);
  color: #FFFFFF;
  font-weight: 600;
}

/* 积分概览 */
.points-bar {
  display: flex;
  align-items: center;
  margin: 24rpx 32rpx;
  padding: 28rpx 0;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

.points-bar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.points-bar__value {
  font-size: var(--font-2xl);
  font-weight: 800;
  color: var(--color-text-primary);
}

.points-bar__label {
  font-size: var(--font-xs);
  color: var(--color-text-muted);
}

.points-bar__divider {
  width: 2rpx;
  height: 48rpx;
  background: var(--color-border);
}

/* VIP 专属信息卡片 */
.vip-card {
  margin: 0 32rpx 24rpx;
  background: linear-gradient(135deg, #FFFBEB, #FEF3C7);
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 2rpx solid #FCD34D;
}

.vip-card__header {
  padding: 24rpx 28rpx 0;
}

.vip-card__title {
  font-size: var(--font-md);
  font-weight: 700;
  color: #D97706;
}

.vip-card__body {
  padding: 16rpx 28rpx 24rpx;
}

.vip-card__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(217, 119, 6, 0.12);
}

.vip-card__item:last-child {
  border-bottom: none;
}

.vip-card__item-label {
  font-size: var(--font-sm);
  color: #92400E;
}

.vip-card__item-value {
  font-size: var(--font-sm);
  font-weight: 600;
  color: #D97706;
}

.vip-card__item-value--highlight {
  font-size: var(--font-md);
  font-weight: 800;
  color: #DC2626;
}

/* 菜单列表 */
.menu-group {
  margin: 0 32rpx 16rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  gap: 20rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--color-muted-bg);
}

.menu-item__icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.menu-item__text {
  flex: 1;
  font-size: var(--font-base);
  color: var(--color-text-primary);
  font-weight: 500;
}

.menu-item__arrow {
  font-size: var(--font-2xl);
  color: var(--color-text-muted);
  font-weight: 300;
}

.menu-item--merchant {
  border-left: 4rpx solid var(--color-secondary);
}

/* 退出登录 */
.logout-section {
  padding: 40rpx 32rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  background: #F3F4F6;
  color: #DC2626;
  font-size: var(--font-base);
  font-weight: 600;
  border-radius: var(--radius-md);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-btn::after {
  border: none;
}

.logout-btn:active {
  background: #E5E7EB;
}
