<view class="container">
  <!-- 积分余额卡片 -->
  <view class="points-card">
    <view class="points-label">当前积分</view>
    <view class="points-value">{{points}}</view>
    <view class="points-hint">看广告赚积分，免费兑好礼</view>
  </view>

  <!-- 广告观看区域 -->
  <view class="ad-section">
    <view class="section-title">🎬 观看广告赚积分</view>

    <!-- 广告卡片 -->
    <view class="ad-card {{adWatching ? 'watching' : ''}}" bindtap="onWatchAd">
      <view class="ad-icon">
        <text wx:if="{{!adWatching}}">📺</text>
        <text wx:else>⏳</text>
      </view>
      <view class="ad-info">
        <text class="ad-title" wx:if="{{!adWatching}}">观看完整广告</text>
        <text class="ad-title" wx:else>广告播放中...</text>
        <text class="ad-reward">+{{rewardPoints}} 积分</text>
      </view>
      <view class="ad-action" wx:if="{{!adWatching}}">
        <text class="ad-btn">立即观看</text>
      </view>
      <view class="ad-action" wx:else>
        <view class="loading-dot"></view>
      </view>
    </view>

    <!-- 今日进度 -->
    <view class="progress-bar">
      <view class="progress-text">
        今日已观看 <text class="highlight">{{todayAdCount}}</text>/{{maxAdCount}} 次
      </view>
      <view class="progress-track">
        <view class="progress-fill" style="width: {{todayAdCount / maxAdCount * 100}}%"></view>
      </view>
    </view>
  </view>

  <!-- 积分规则 -->
  <view class="rules-section">
    <view class="section-title">📋 积分规则</view>
    <view class="rules-list">
      <view class="rule-item" wx:for="{{rules}}" wx:key="*this">
        <text class="rule-dot">•</text>
        <text class="rule-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 最近记录 -->
  <view class="history-section" wx:if="{{history.length > 0}}">
    <view class="section-title">📊 最近获取记录</view>
    <view class="history-list">
      <view class="history-item" wx:for="{{history}}" wx:key="id">
        <view class="h-left">
          <text class="h-type">{{item.description || '观看广告奖励'}}</text>
          <text class="h-time">{{item.created_at}}</text>
        </view>
        <text class="h-points">+{{item.points}}</text>
      </view>
    </view>
  </view>

  <!-- 底部安全距离 -->
  <view class="bottom-safe"></view>

  <!-- 奖励动画浮层 -->
  <view class="reward-overlay {{showRewardAnim ? 'show' : ''}}" wx:if="{{showRewardAnim}}">
    <view class="reward-popup">
      <text class="reward-icon">🎉</text>
      <text class="reward-text">恭喜获得</text>
      <text class="reward-points">+{{lastReward}} 积分</text>
      <text class="reward-sub">积分已发放到您的账户</text>
    </view>
  </view>
</view>
