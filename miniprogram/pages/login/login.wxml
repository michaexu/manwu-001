<!--
  登录页 — 手机号 + 密码登录
-->
<view class="login-page">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <view class="login-content">
    <!-- Logo -->
    <view class="logo-area">
      <view class="logo-icon">
        <text class="logo-emoji">🎁</text>
      </view>
      <text class="welcome-text">欢迎来到积分活动</text>
      <text class="subtitle">签到、看广告赚积分，兑换好礼</text>
    </view>

    <!-- 输入卡片 -->
    <view class="phone-card">
      <!-- 手机号 -->
      <view class="input-row">
        <text class="input-prefix">+86</text>
        <input
          class="input-field"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          value="{{phone}}"
          bindinput="onPhoneInput"
        />
      </view>

      <view class="input-divider"></view>

      <!-- 密码 -->
      <view class="input-row">
        <input
          class="input-field"
          type="text"
          password="{{true}}"
          maxlength="20"
          placeholder="请输入密码"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
      </view>
    </view>

    <!-- 协议勾选 -->
    <view class="agree-row" bindtap="onToggleAgree">
      <view class="checkbox {{agreed ? 'checkbox--checked' : ''}}">
        <text wx:if="{{agreed}}" class="checkbox-icon">✓</text>
      </view>
      <view class="agree-text-wrap">
        <text class="agree-text">已阅读并同意</text>
        <text class="agree-link" data-type="用户协议" catchtap="onViewAgreement">《用户协议》</text>
        <text class="agree-text">和</text>
        <text class="agree-link" data-type="隐私政策" catchtap="onViewAgreement">《隐私政策》</text>
      </view>
    </view>

    <!-- 登录按钮 -->
    <view class="login-btn {{loading ? 'login-btn--loading' : ''}}" bindtap="onLogin">
      <text wx:if="{{!loading}}">登录 / 注册</text>
      <text wx:else>登录中...</text>
    </view>
  </view>
</view>
