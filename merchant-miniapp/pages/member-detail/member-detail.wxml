<view class="page">
  <view class="loading-container" wx:if="{{isLoading}}"><text>加载中...</text></view>

  <block wx:else>
    <view class="profile-header" wx:if="{{member}}">
      <block wx:if="{{member.avatarUrl}}">
        <image class="profile-avatar" src="{{member.avatarUrl}}" mode="aspectFill" />
      </block>
      <view wx:else class="profile-avatar avatar-placeholder-lg">
        <text class="avatar-placeholder-lg-text">{{member.nickname ? member.nickname.slice(0,1) : 'U'}}</text>
      </view>
      <text class="profile-name">{{member.nickname || '微信用户'}}</text>
      <text class="{{member.memberType === 'vip' ? 'tag-vip' : 'tag-regular'}}">{{member.memberType === 'vip' ? 'VIP 会员' : '普通会员'}}</text>
    </view>

    <view class="card">
      <view class="info-row"><text class="info-label">手机号</text><text>{{member.phone || '未绑定'}}</text></view>
      <view class="info-row"><text class="info-label">积分余额</text><text>{{member.pointsBalance || 0}}</text></view>
      <view class="info-row"><text class="info-label">注册时间</text><text>{{member.createdAt}}</text></view>
    </view>
  </block>
</view>
