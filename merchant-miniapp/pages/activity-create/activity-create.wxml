<view class="page">
  <view class="form-container">
    <view class="form-group">
      <text class="form-label">活动名称 *</text>
      <input class="form-input" placeholder="请输入活动名称（最多30字）" maxlength="30" value="{{form.title}}" data-field="title" bindinput="handleInput" />
    </view>
    <view class="form-group">
      <text class="form-label">活动封面图</text>
      <input class="form-input" placeholder="请输入图片 URL" value="{{form.coverImage}}" data-field="coverImage" bindinput="handleInput" />
    </view>
    <view class="form-group">
      <text class="form-label">奖品描述</text>
      <textarea class="form-textarea" placeholder="描述奖品内容" value="{{form.prizeDesc}}" data-field="prizeDesc" bindinput="handleInput" />
    </view>
    <view class="form-group">
      <text class="form-label">领取地点 *</text>
      <input class="form-input" placeholder="请输入门店地址" value="{{form.location}}" data-field="location" bindinput="handleInput" />
    </view>
    <view class="form-group">
      <text class="form-label">领取开始时间 *</text>
      <picker mode="date" value="{{form.startTime}}" data-field="startTime" bindchange="handleInput">
        <view class="form-input">{{form.startTime || '请选择日期'}}</view>
      </picker>
    </view>
    <view class="form-group">
      <text class="form-label">领取结束时间 *</text>
      <picker mode="date" value="{{form.endTime}}" data-field="endTime" bindchange="handleInput">
        <view class="form-input">{{form.endTime || '请选择日期'}}</view>
      </picker>
    </view>
    <view class="form-group">
      <text class="form-label">所需积分</text>
      <input class="form-input" type="number" placeholder="0 = 免费" value="{{form.pointsRequired}}" data-field="pointsRequired" bindinput="handleInput" />
    </view>
    <view class="form-row">
      <view class="form-group half">
        <text class="form-label">VIP 名额</text>
        <input class="form-input" type="number" placeholder="0=不限" value="{{form.vipQuota}}" data-field="vipQuota" bindinput="handleInput" />
      </view>
      <view class="form-group half">
        <text class="form-label">普通名额</text>
        <input class="form-input" type="number" placeholder="0=不限" value="{{form.regularQuota}}" data-field="regularQuota" bindinput="handleInput" />
      </view>
    </view>
    <view class="form-group">
      <text class="form-label">活动说明</text>
      <textarea class="form-textarea" placeholder="注意事项、领取须知等" value="{{form.description}}" data-field="description" bindinput="handleInput" />
    </view>
  </view>

  <view class="bottom-bar">
    <button class="btn-secondary" catchtap="handleSaveDraft" disabled="{{submitting}}">保存草稿</button>
    <button class="btn-primary" catchtap="handlePublish" disabled="{{submitting}}" style="margin-left:20rpx;">直接发布</button>
  </view>
</view>
