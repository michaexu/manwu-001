<view class="page">
  <view class="page-title">核销确认</view>

  <!-- 会员信息 -->
  <view class="card">
    <view class="user-section" wx:if="{{member}}">
      <block wx:if="{{member.avatarUrl}}">
        <image class="user-avatar" src="{{member.avatarUrl}}" mode="aspectFill" />
      </block>
      <view wx:else class="user-avatar avatar-placeholder-md">
        <text class="avatar-placeholder-md-text">{{member.nickname ? member.nickname.slice(0,1) : 'U'}}</text>
      </view>
      <view class="user-info">
        <text class="user-name">{{member.nickname}}</text>
        <text class="{{member.memberType === 'vip' ? 'tag-vip' : 'tag-regular'}}">
          {{member.memberType === 'vip' ? 'VIP 会员' : '普通会员'}}
        </text>
      </view>
    </view>
  </view>

  <!-- 活动信息 -->
  <view class="card" wx:if="{{activity}}">
    <view class="section-label">活动信息</view>
    <view class="info-row"><text class="info-label">活动</text><text>{{activity.title}}</text></view>
    <view class="info-row"><text class="info-label">奖品</text><text>{{activity.prizeDesc || '奖品'}}</text></view>
    <view class="info-row"><text class="info-label">领取地点</text><text>{{activity.location}}</text></view>
  </view>

  <!-- 按钮 -->
  <view class="bottom-bar">
    <button class="btn-primary" catchtap="handleConfirm" disabled="{{isClaiming}}">
      {{isClaiming ? '核销中...' : '确认核销'}}
    </button>
    <button class="btn-secondary" catchtap="wx.navigateBack" style="margin-top:20rpx;">取消</button>
  </view>
</view>
