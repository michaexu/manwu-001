.page { min-height: 100vh; padding-bottom: 200rpx; }

.card { margin-bottom: 16rpx; }

.user-section {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #2D1B00;
  display: block;
  margin-bottom: 12rpx;
}

.section-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D1B00;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 30rpx;
  border-bottom: 2rpx solid #F0E8DE;
}
.info-row:last-child { border-bottom: none; }

.info-label { color: #8B7A66; }

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.avatar-placeholder-md {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #F0E8DE;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.avatar-placeholder-md-text {
  color: #8B7A66;
  font-size: 36rpx;
  font-weight: 600;
}
