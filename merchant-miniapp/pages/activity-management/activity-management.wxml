<view class="page">
  <!-- 顶部操作栏 -->
  <view class="top-bar">
    <button class="btn-primary create-btn" catchtap="goToCreate">＋ 新建活动</button>
  </view>

  <!-- 状态筛选 -->
  <view class="filter-bar">
    <view
      class="filter-item {{filterStatus === opt.value ? 'active' : ''}}"
      wx:for="{{statusOptions}}"
      wx:key="value"
      data-status="{{opt.value}}"
      catchtap="filterByStatus"
    >{{opt.label}}</view>
  </view>

  <!-- 活动列表 -->
  <view class="activity-list">
    <view class="act-item card" wx:for="{{activities}}" wx:key="id">
      <view class="act-header" data-id="{{item.id}}" catchtap="goToDetail">
        <text class="act-title">{{item.title}}</text>
        <text class="act-status status-{{item.status}}">{{item.status === 'published' ? '进行中' : item.status === 'draft' ? '草稿' : item.status === 'ended' ? '已结束' : '已下架'}}</text>
      </view>
      <view class="act-meta">
        <text>参与 {{item.currentCount || 0}} 人</text>
        <text wx:if="{{item.claimedCount}}">核销 {{item.claimedCount}} 人</text>
        <text wx:if="{{item.claimRate}}">核销率 {{item.claimRate}}%</text>
      </view>
      <view class="act-time">{{item.startTime?.slice(0, 16)}} ~ {{item.endTime?.slice(0, 16)}}</view>
      <view class="act-actions" wx:if="{{item.status === 'draft'}}">
        <button class="btn-primary" size="mini" data-id="{{item.id}}" catchtap="handlePublish">发布</button>
        <button class="btn-secondary" size="mini" data-id="{{item.id}}" catchtap="goToDetail">编辑</button>
      </view>
      <view class="act-actions" wx:if="{{item.status === 'published'}}">
        <button class="btn-secondary" size="mini" data-id="{{item.id}}" catchtap="handleUnpublish">下架</button>
        <button class="btn-secondary" size="mini" data-id="{{item.id}}" catchtap="goToDetail">详情</button>
      </view>
    </view>
  </view>

  <view class="loading-container" wx:if="{{isLoading}}"><text>加载中...</text></view>
  <view class="empty-state" wx:if="{{!isLoading && activities.length === 0}}"><text>暂无活动</text></view>
</view>
