<view class="page">
  <view class="top-bar">
    <button class="btn-primary create-btn" catchtap="showCreateForm">＋ 新增广告位</button>
  </view>

  <view class="ad-list">
    <view class="ad-item card" wx:for="{{ads}}" wx:key="id" data-ad="{{item}}" catchtap="showEditForm">
      <view class="ad-header">
        <text class="ad-name">{{item.name}}</text>
        <text class="ad-status {{item.isActive ? 'active' : 'inactive'}}">{{item.isActive ? '启用' : '停用'}}</text>
      </view>
      <view class="ad-meta">
        <text>ID: {{item.adUnitId}}</text>
        <text>奖励 {{item.pointsReward}} 积分</text>
        <text>每日 {{item.dailyLimit}} 次</text>
      </view>
    </view>
  </view>

  <view class="loading-container" wx:if="{{isLoading}}"><text>加载中...</text></view>

  <!-- 表单弹窗 -->
  <view class="modal-overlay" wx:if="{{formVisible}}" catchtap="hideForm">
    <view class="modal-content" catchtap=""><!-- stop propagation -->
      <view class="modal-title">{{editAd ? '编辑广告位' : '新增广告位'}}</view>

      <view class="form-group"><text class="form-label">广告位名称</text><input class="form-input" placeholder="如：首页广告位" value="{{form.name}}" data-field="name" bindinput="handleInput" /></view>
      <view class="form-group"><text class="form-label">广告单元 ID</text><input class="form-input" placeholder="微信流量主 ad unit id" value="{{form.adUnitId}}" data-field="adUnitId" bindinput="handleInput" /></view>
      <view class="form-group"><text class="form-label">积分奖励值</text><input class="form-input" type="number" value="{{form.pointsReward}}" data-field="pointsReward" bindinput="handleInput" /></view>
      <view class="form-group"><text class="form-label">每日领取上限</text><input class="form-input" type="number" value="{{form.dailyLimit}}" data-field="dailyLimit" bindinput="handleInput" /></view>
      <view class="form-group">
        <text class="form-label">状态</text>
        <switch checked="{{form.isActive}}" bindchange="handleToggleActive" />
      </view>

      <view class="modal-actions">
        <button class="btn-secondary" catchtap="hideForm">取消</button>
        <button class="btn-primary" catchtap="handleSave" style="margin-left:20rpx;">保存</button>
      </view>
    </view>
  </view>
</view>
