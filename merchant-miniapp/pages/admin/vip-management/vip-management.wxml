<view class="page">
  <view class="page-title">VIP 管理</view>

  <view class="search-bar">
    <input class="search-input" placeholder="搜索会员" value="{{keyword}}" bindinput="handleSearch" bindconfirm="onSearchConfirm" confirm-type="search" />
  </view>

  <view class="member-list">
    <view class="member-item card" wx:for="{{members}}" wx:key="id">
      <block wx:if="{{item.avatarUrl}}">
        <image class="member-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
      </block>
      <view wx:else class="member-avatar avatar-placeholder-sm">
        <text class="avatar-placeholder-sm-text">{{item.nickname ? item.nickname.slice(0,1) : 'U'}}</text>
      </view>
      <view class="member-info">
        <text class="member-name">{{item.nickname || '微信用户'}}</text>
        <text class="{{item.memberType === 'vip' ? 'tag-vip' : 'tag-regular'}}">{{item.memberType === 'vip' ? 'VIP' : '普通'}}</text>
      </view>
      <button class="vip-btn {{item.memberType === 'vip' ? 'revoke' : 'grant'}}" size="mini" data-id="{{item.id}}" data-is-vip="{{item.memberType === 'vip'}}" data-nickname="{{item.nickname}}" catchtap="handleToggleVip">
        {{item.memberType === 'vip' ? '撤销' : '开通'}}
      </button>
    </view>
  </view>

  <view class="loading-container" wx:if="{{isLoading}}"><text>加载中...</text></view>
</view>
