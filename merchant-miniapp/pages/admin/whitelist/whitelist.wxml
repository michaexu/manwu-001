<view class="page">
  <view class="top-bar">
    <button class="btn-primary create-btn" catchtap="showAddForm">＋ 添加操作员</button>
  </view>

  <view class="list">
    <view class="item card" wx:for="{{list}}" wx:key="id">
      <view class="item-info">
        <text class="item-phone">{{item.phone}}</text>
        <text class="item-name">{{item.nickname || '-'}}</text>
      </view>
      <button class="btn-secondary danger" size="mini" data-id="{{item.id}}" data-phone="{{item.phone}}" catchtap="handleDelete">删除</button>
    </view>
  </view>

  <view class="loading-container" wx:if="{{isLoading}}"><text>加载中...</text></view>
  <view class="empty-state" wx:if="{{!isLoading && list.length === 0}}"><text>暂无操作员</text></view>

  <view class="modal-overlay" wx:if="{{showForm}}" catchtap="hideForm">
    <view class="modal-content" catchtap="">
      <view class="modal-title">添加操作员</view>
      <view class="form-group"><text class="form-label">手机号 *</text><input class="form-input" placeholder="请输入手机号" value="{{phone}}" bindinput="handlePhoneInput" type="number" maxlength="11" /></view>
      <view class="form-group"><text class="form-label">名称</text><input class="form-input" placeholder="操作员昵称（选填）" value="{{nickname}}" bindinput="handleNameInput" /></view>
      <view class="modal-actions">
        <button class="btn-secondary" catchtap="hideForm">取消</button>
        <button class="btn-primary" catchtap="handleAdd" style="margin-left:20rpx;">添加</button>
      </view>
    </view>
  </view>
</view>
