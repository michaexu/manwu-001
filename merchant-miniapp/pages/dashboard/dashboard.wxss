.page { min-height: 100vh; padding-bottom: 30rpx; }

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 0 24rpx;
}

.stat-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.stat-num {
  font-size: 52rpx;
  font-weight: 700;
  color: #D4A030;
  display: block;
}

.stat-label {
  font-size: 26rpx;
  color: #8B7A66;
  display: block;
  margin-top: 8rpx;
}

.menu-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
  padding: 0 24rpx;
}

.menu-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.menu-icon {
  font-size: 56rpx;
  display: block;
  margin-bottom: 12rpx;
}

.menu-name {
  font-size: 28rpx;
  color: #2D1B00;
  display: block;
}
