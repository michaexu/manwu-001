<view class="page">
  <view class="page-title">数据概览</view>

  <!-- 核心指标 -->
  <view class="stats-grid" wx:if="{{dashboard}}">
    <view class="stat-card">
      <text class="stat-num">{{dashboard.memberCount || 0}}</text>
      <text class="stat-label">总会员</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{dashboard.vipCount || 0}}</text>
      <text class="stat-label">VIP 会员</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{dashboard.activityCount || 0}}</text>
      <text class="stat-label">活动总数</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{dashboard.totalRegistrations || 0}}</text>
      <text class="stat-label">总参与</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{dashboard.claimedCount || 0}}</text>
      <text class="stat-label">已核销</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{dashboard.claimRate || 0}}%</text>
      <text class="stat-label">核销率</text>
    </view>
  </view>

  <!-- 管理入口 -->
  <view class="page-title">快捷管理</view>
  <view class="menu-grid">
    <view class="menu-item" data-page="/pages/activity-management/activity-management" catchtap="goTo">
      <text class="menu-icon">📋</text>
      <text class="menu-name">活动管理</text>
    </view>
    <view class="menu-item" data-page="/pages/scan-verify/scan-verify" catchtap="goTo">
      <text class="menu-icon">📷</text>
      <text class="menu-name">扫码核销</text>
    </view>
    <view class="menu-item" data-page="/pages/member-management/member-management" catchtap="goTo">
      <text class="menu-icon">👥</text>
      <text class="menu-name">会员管理</text>
    </view>
    <view class="menu-item" data-page="/pages/admin/vip-management/vip-management" catchtap="goTo">
      <text class="menu-icon">⭐</text>
      <text class="menu-name">VIP 管理</text>
    </view>
    <view class="menu-item" data-page="/pages/admin/ad-config/ad-config" catchtap="goTo">
      <text class="menu-icon">📢</text>
      <text class="menu-name">广告配置</text>
    </view>
    <view class="menu-item" data-page="/pages/admin/whitelist/whitelist" catchtap="goTo">
      <text class="menu-icon">🔐</text>
      <text class="menu-name">白名单</text>
    </view>
  </view>

  <view class="loading-container" wx:if="{{isLoading}}"><text>加载中...</text></view>
</view>
