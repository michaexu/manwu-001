.page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-container {
  width: 80%;
  text-align: center;
}

.login-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.login-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2D1B00;
  margin-bottom: 16rpx;
}

.login-desc {
  font-size: 28rpx;
  color: #8B7A66;
  margin-bottom: 80rpx;
}

.login-btn {
  width: 100%;
  margin-bottom: 30rpx;
}

.login-hint {
  font-size: 26rpx;
  color: #8B7A66;
}
