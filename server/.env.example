# 服务配置
PORT=3091
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=five

# JWT 配置
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# 微信小程序配置 - 客户版
WX_APPID_CUSTOMER=your_customer_miniapp_appid
WX_SECRET_CUSTOMER=your_customer_miniapp_secret

# 微信小程序配置 - 商家版
WX_APPID_MERCHANT=your_merchant_miniapp_appid
WX_SECRET_MERCHANT=your_merchant_miniapp_secret

# 二维码签名密钥
QR_SECRET=your_qr_code_hmac_secret

# 管理员默认账号（首次启动时创建）
ADMIN_PHONE=13800000000

# 微信流量主广告配置（可选）
WX_AD_REWARD_VERIFY=false
