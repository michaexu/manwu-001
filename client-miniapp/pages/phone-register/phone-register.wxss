.page {
  min-height: 100vh;
  padding: 80rpx 40rpx;
  background: #FFFFFF;
}

.register-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.register-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2D1B00;
  display: block;
  margin-bottom: 16rpx;
}

.register-desc {
  font-size: 30rpx;
  color: #8B7A66;
}

.form-group {
  margin-bottom: 36rpx;
}

.form-label {
  font-size: 30rpx;
  color: #2D1B00;
  font-weight: 500;
  display: block;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 30rpx;
  background: #FFF8F0;
  border: 2rpx solid #F0E8DE;
  border-radius: 16rpx;
  font-size: 32rpx;
  box-sizing: border-box;
}

.register-btn {
  width: 100%;
  margin-top: 24rpx;
}

.footer {
  text-align: center;
  margin-top: 100rpx;
}

.footer-link {
  font-size: 28rpx;
  color: #C41E1E;
}
