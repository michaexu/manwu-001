<view class="page">
  <view class="register-header">
    <text class="register-title">登录 / 注册</text>
    <text class="register-desc">输入手机号即可</text>
  </view>

  <view class="form-container">
    <view class="form-group">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入11位手机号" value="{{phone}}" bindinput="handlePhoneInput" />
    </view>
    <view class="form-group">
      <text class="form-label">昵称（选填）</text>
      <input class="form-input" placeholder="你的昵称" value="{{nickname}}" bindinput="handleNameInput" />
    </view>

    <button class="btn-primary register-btn" catchtap="handleRegister" disabled="{{isRegistering || phone.length < 11}}">
      {{isRegistering ? '登录中...' : '登录 / 注册'}}
    </button>
  </view>

  <view class="footer">
    <text class="footer-link" catchtap="goBack">返回首页</text>
  </view>
</view>
