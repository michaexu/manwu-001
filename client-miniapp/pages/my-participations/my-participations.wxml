<view class="page">
  <view class="page-title">
    <text>我的参与</text>
  </view>

  <view class="registration-list">
    <view class="reg-item card" wx:for="{{registrations}}" wx:key="id">
      <view class="reg-header">
        <text class="reg-title">{{item.activity.title}}</text>
        <text class="reg-status status-{{item.status}}">{{statusText[item.status]}}</text>
      </view>
      <view class="reg-meta">
        <text>📍 {{item.activity.location}}</text>
        <text wx:if="{{item.pointsCost > 0}}">消耗 {{item.pointsCost}} 积分</text>
        <text wx:else>免费参与</text>
      </view>

      <view class="reg-actions">
        <!-- 已报名 - 可查看码或取消 -->
        <button class="btn-primary" wx:if="{{item.status === 'registered'}}" size="mini" data-id="{{item.id}}" catchtap="goToQrCode">查看领奖码</button>
        <button class="btn-secondary" wx:if="{{item.status === 'registered'}}" size="mini" data-id="{{item.id}}" data-points-cost="{{item.pointsCost}}" data-activity-title="{{item.activity.title}}" catchtap="handleCancel">取消报名</button>
        <!-- 已核销 -->
        <text class="claimed-info" wx:if="{{item.status === 'claimed'}}">核销于 {{item.claimedAt}}</text>
        <!-- 已取消 -->
        <text class="cancelled-info" wx:if="{{item.status === 'cancelled'}}">已取消</text>
      </view>
    </view>
  </view>

  <view class="loading-container" wx:if="{{isLoading}}"><text>加载中...</text></view>

  <view class="empty-state" wx:if="{{!isLoading && registrations.length === 0}}">
    <text>暂无参与记录</text>
    <text style="font-size:24rpx;color:#ccc;margin-top:16rpx;">去活动广场看看有什么精彩活动吧</text>
  </view>
</view>
