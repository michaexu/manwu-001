<view class="page">
  <!-- 余额概览 -->
  <view class="balance-header">
    <text class="balance-label">当前积分</text>
    <text class="balance-value">{{currentBalance}}</text>
  </view>

  <!-- 筛选 -->
  <view class="filter-bar">
    <view class="filter-item {{filterType === '' ? 'active' : ''}}" data-type="" catchtap="filterByType">全部</view>
    <view class="filter-item {{filterType === 'earn_ad' ? 'active' : ''}}" data-type="earn_ad" catchtap="filterByType">获得</view>
    <view class="filter-item {{filterType === 'cost_activity' ? 'active' : ''}}" data-type="cost_activity" catchtap="filterByType">消耗</view>
    <view class="filter-item {{filterType === 'refund_cancel' ? 'active' : ''}}" data-type="refund_cancel" catchtap="filterByType">退还</view>
  </view>

  <!-- 明细列表 -->
  <view class="records-list">
    <view class="record-item card" wx:for="{{records}}" wx:key="id">
      <view class="record-left">
        <text class="record-type">{{typeText[item.changeType] || item.changeType}}</text>
        <text class="record-time">{{item.createdAt}}</text>
        <text class="record-remark" wx:if="{{item.remark}}">{{item.remark}}</text>
      </view>
      <view class="record-right">
        <text class="record-amount {{item.changeAmount > 0 ? 'positive' : 'negative'}}">
          {{item.changeAmount > 0 ? '+' : ''}}{{item.changeAmount}}
        </text>
        <text class="record-balance">余额 {{item.balanceAfter}}</text>
      </view>
    </view>
  </view>

  <view class="loading-container" wx:if="{{isLoading}}"><text>加载中...</text></view>
  <view class="empty-state" wx:if="{{!isLoading && records.length === 0}}">
    <text>暂无积分记录</text>
  </view>
</view>
