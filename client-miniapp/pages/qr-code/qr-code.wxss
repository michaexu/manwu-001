.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 24rpx;
}

.qr-header {
  width: 100%;
  margin-bottom: 48rpx;
  text-align: center;
}

.qr-activity-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2D1B00;
  display: block;
  margin-bottom: 16rpx;
}

.qr-location {
  font-size: 28rpx;
  color: #8B7A66;
}

.qr-container {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 48rpx;
}

.qr-image {
  width: 420rpx;
  height: 420rpx;
  display: block;
}

.qr-tip {
  text-align: center;
  color: #8B7A66;
  font-size: 28rpx;
  margin-top: 32rpx;
}

.qr-actions {
  width: 80%;
}
